# Optional interface to bind; Docker Compose overrides this with 0.0.0.0.
HOST=127.0.0.1
# Port the scraper HTTP server listens on.
SCRAPE_PORT=1951
# Milliseconds between scheduled scraper runs.
SCRAPE_INTERVAL=3600000

# MongoDB connection string; Docker Compose overrides this for its Mongo service.
MONGO_URI=mongodb://127.0.0.1:27017
# MongoDB database name.
DB_NAME=your-database-name
# MongoDB collection for scraped articles.
ARTICLES_COLLECTION=your-articles-collection
# MongoDB collection for scraped picture sets.
PICSETS_COLLECTION=your-picture-sets-collection
# MongoDB collection for downloaded picture metadata.
PICS_COLLECTION=your-pictures-collection
# MongoDB collection for scrape logs.
LOG_COLLECTION=your-scrape-log-collection

# Base URL of the KCNA website.
KCNA_BASE_URL=http://www.example.com

# Telegram channel identifier that receives scraper posts.
TG_CHANNEL_ID=replace-with-telegram-channel-id
# Maximum Telegram message length in characters.
TG_MAX_LENGTH=4096
# Comma-separated environment-variable names whose values are bot tokens.
TOKEN_ARRAY=BOT_TOKEN_1,BOT_TOKEN_2
# Telegram bot token referenced by BOT_TOKEN_1 in TOKEN_ARRAY.
BOT_TOKEN_1=replace-with-first-bot-token
# Telegram bot token referenced by BOT_TOKEN_2 in TOKEN_ARRAY.
BOT_TOKEN_2=replace-with-second-bot-token

# Directory for downloaded pictures; Docker Compose overrides this with /data/pics.
PIC_PATH=replace-with-picture-directory
# Bytes downloaded between progress log messages.
PIC_PROGRESS_SIZE=102400

# Password required by the scraper API.
API_PASSWORD=replace-with-api-password
# Route mounted for the scraper API.
API_SCRAPER=/api/scrape
